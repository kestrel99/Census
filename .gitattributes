# Normalize line endings: Git stores text as LF, checks out native per platform.
* text=auto

# .NET / new codebase source — keep LF in the repo.
*.cs        text eol=lf
*.csproj    text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.slnx      text eol=lf
*.axaml     text eol=lf
*.xaml      text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.sql       text eol=lf
*.manifest  text eol=lf

# Visual Studio solution files expect CRLF.
*.sln       text eol=crlf

# Platform-specific scripts.
*.sh        text eol=lf
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Legacy Lazarus/Pascal sources — leave endings untouched to avoid churn.
*.pas       -text
*.lfm       -text
*.lpr       -text
*.lpi       -text
*.lps       -text
*.inc       -text

# Binary assets (never normalize).
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.bmp  binary
*.pdf  binary
*.zip  binary
*.dll  binary
*.exe  binary
*.db   binary
*.cen  binary
*.res  binary
*.lrs  binary
