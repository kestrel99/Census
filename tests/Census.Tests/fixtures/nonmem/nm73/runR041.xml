<nm:control_stream><![CDATA[
$PROB    BOLUS_2CPT_V1QV2VMKM MULTIPLE DOSE FOCEI (120 Ind/4680 Obs) runR041
$INPUT   ID TIME DV=DROP LNDV=DV MDV AMT EVID DOSE VI VMI KMI QI V2I SD CMT
$DATA    BOLUS_2CPTMM.csv IGNORE=@ IGNORE(SD.EQ.1)
$SUBR    ADVAN6 TOL=5
$MODEL   COMP=(CENTRAL,DEFOBS,DEFDOSE)
         COMP=(PERI)
$PK      VM=THETA(1)*EXP(ETA(1))
         KM=THETA(2)*EXP(ETA(2))
         V1=THETA(3)*EXP(ETA(3))
         Q=THETA(4)*EXP(ETA(4))
         V2=THETA(5)*EXP(ETA(5))
         K12=Q/V1
         K21=Q/V2
         S1=V1
$DES     C1=A(1)/V1
         DADT(1)= K21*A(2)-K12*A(1)-VM*C1/(KM+C1)
         DADT(2)=-K21*A(2)+K12*A(1)
$ERROR   (ONLY OBSERVATIONS)
         IPRED=LOG(0.0025)
         W=THETA(6)
         IF (F.GT.0) IPRED=LOG(F)
         IRES=IPRED-DV
         IWRES=IRES/W
         Y=IPRED+W*ERR(1)
$THETA   (0,1250) (0,300) (0,75,300) (0,4.5,15) (0,55,150) (0,0.3,1)
;#       VM KM V1 Q V2 RSV
$OMEGA   0.15 0.15 0.15 0.15 0.15
$SIGMA   1 FIX
$EST     NSIG=3 PRINT=5 MAX=9999 NOABORT POSTHOC METHOD=COND INTER NOOBT
$COV
$TABLE  ID TIME DV MDV AMT EVID DOSE VI VMI KMI QI V2I V1 VM KM Q V2 ETA1 ETA2 ETA3 ETA4 ETA5
        IPRED IRES IWRES CWRESI
        ONEHEADER NOPRINT FILE=runR041.csv
]]></nm:control_stream>
