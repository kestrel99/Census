<nm:control_stream><![CDATA[
$PROB    ORAL1_1CPT_KAVK SINGLE DOSE FOCEI (120 Ind/2273 Obs) ODE runR027
$INPUT   ID TIME DV=DROP LNDV=DV MDV AMT EVID DOSE VI CLI KAI SSX IIX SD CMT
$DATA    ORAL_1CPT.csv IGNORE=@ IGNORE (SD.EQ.0)
$SUBR    ADVAN6 TOL=5

$MODEL
         COMP=(ABS,DEFDOSE)
         COMP=(CENTRAL,DEFOBS)
$PK
         K=EXP(THETA(1)+ETA(1))
         V=EXP(THETA(2)+ETA(2))
         KA=EXP(THETA(3)+ETA(3))
         S2=V
$DES
         DADT(1)= -KA*A(1)
         DADT(2)=  KA*A(1)-K*A(2)

$ERROR   (ONLY OBSERVATIONS)
         IPRED=LOG(0.0025)
         W=THETA(4)
         IF (F.GT.0) IPRED=LOG(F)
         IRES=IPRED-DV
         IWRES=IRES/W
         Y=IPRED+W*ERR(1)
$THETA   -3 4.5 0.2 (0,0.3,1)
;#       CL V Ka RSV
$OMEGA   0.15 0.15 0.15
;#       IIV_CL IIV_V IIV_Ka
$SIGMA   1 FIX
;#       RSV_FIX
$EST     NSIG=3 PRINT=5 MAX=9999 NOABORT POSTHOC METHOD=COND INTER NOOBT
$COV
$TABLE   ID TIME LNDV MDV AMT EVID DOSE VI CLI KAI K V KA ETA1 ETA2 ETA2
         IPRED IRES IWRES CWRESI
         ONEHEADER NOPRINT FILE=runR027.csv
]]></nm:control_stream>
